    "dry-run": "tsx src/index.ts --dry-run",
    "status": "tsx src/index.ts --status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "chalk": "^5.4.1",
    "cli-spinners": "^3.2.0",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "glob": "^11.0.0",
    "inquirer": "^12.4.0",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
