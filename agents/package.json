{
  "name": "sankalp-aei-agents",
  "version": "1.0.0",
  "description": "Multi-agent orchestration system for SANKALP-AEI development",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
