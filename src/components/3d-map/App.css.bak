/* ═══════════════════════════════════════════════════════
   SANKALP Brain Map — Premium CSS
   Dark glassmorphic dashboard
   ═══════════════════════════════════════════════════════ */
:root {
  --bg: #0a0b14;
  --glass: rgba(12, 14, 28, 0.78);
  --glass-border: rgba(255, 255, 255, 0.06);
  --glass-hover: rgba(255, 255, 255, 0.08);
  --text: #e2e8f0;
  --muted: #64748b;
  --accent: #7c3aed;
  --blue: #3b82f6;
  --cyan: #06b6d4;
  --green: #22c55e;
  --red: #ef4444;
  --amber: #f59e0b;
  --radius: 16px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

/* body styles removed to prevent breaking global layout */

.app { 
  position: relative; 
  width: 100%; 
  height: calc(100vh - 120px); /* 120px accounts for header/spacing if needed */
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--bg);
}

.canvas-3d {
  position: absolute !important;
  top: 0; left: 0;
  width: 100% !important;
  height: 100% !important;
  z-index: 0;
}

/* ── Glass Panel Base ───────────────────────────────── */
.glass {
  background: var(--glass);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
}

/* ── Header ─────────────────────────────────────────── */
.header {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  z-index: 10;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(10,11,20,0.85) 0%, transparent 100%);
}

.header-logo {
  width: 36px; height: 36px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--accent), var(--blue));
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
}

.header-brand {
  display: flex; flex-direction: column;
}

.header-sub {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--muted);
}

.header-title {
  font-size: 18px;
  font-weight: 700;
  background: linear-gradient(135deg, #a78bfa, #60a5fa, #22d3ee);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
}

.header-tags {
  display: flex; gap: 8px; margin-left: 12px;
}

.tag {
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .8px;
  text-transform: uppercase;
}

.tag-3d     { background: rgba(6,182,212,.12); color: #22d3ee; border: 1px solid rgba(6,182,212,.2); }
.tag-knn    { background: rgba(59,130,246,.12); color: #60a5fa; border: 1px solid rgba(59,130,246,.2); }
.tag-louv   { background: rgba(124,58,237,.12); color: #a78bfa; border: 1px solid rgba(124,58,237,.2); }
.tag-prev   { background: rgba(239,68,68,.1);   color: #f87171; border: 1px solid rgba(239,68,68,.15); }

/* ── Left Sidebar ───────────────────────────────────── */
.sidebar {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 6px;
}

.sb-btn {
  width: 40px; height: 40px;
  border-radius: 12px;
  border: none;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s ease;
  font-size: 16px;
}

.sb-btn:hover,
.sb-btn.active {
  background: var(--glass-hover);
  color: var(--accent);
}

.sb-btn.active {
  background: rgba(124,58,237,.15);
  color: #a78bfa;
  box-shadow: inset 0 0 0 1px rgba(124,58,237,.3);
}

/* ── Stats Panel (Top-Right) ────────────────────────── */
.stats-panel {
  position: absolute;
  top: 70px;
  right: 16px;
  width: 240px;
  z-index: 10;
  padding: 16px;
}

.sp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.sp-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  display: flex; align-items: center; gap: 6px;
}

.sp-icon { font-size: 14px; opacity: 0.7; }

.sp-dropdown {
  font-size: 10px;
  background: rgba(255,255,255,.04);
  border: 1px solid var(--glass-border);
  border-radius: 8px;
  padding: 4px 10px;
  color: var(--muted);
  cursor: pointer;
}

.sp-label {
  font-size: 9px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--muted);
  margin: 14px 0 8px;
}

.sp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border-radius: 10px;
  background: rgba(255,255,255,.02);
  margin-bottom: 6px;
  cursor: pointer;
  transition: background 0.15s;
}

.sp-row:hover { background: rgba(255,255,255,.05); }

.sp-row-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.sp-row-icon {
  width: 28px; height: 28px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px;
}

.sp-row-label { font-size: 10px; color: var(--muted); }
.sp-row-value { font-size: 16px; font-weight: 700; }

.sp-row-right {
  font-size: 14px;
  color: var(--muted);
}

/* ── Mini Cards (Bottom-Left) ───────────────────────── */
.mini-cards {
  position: absolute;
  bottom: 16px;
  left: 72px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 220px;
}

.mc-card {
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.mc-icon {
  width: 32px; height: 32px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}

.mc-body { flex: 1; min-width: 0; }
.mc-label { font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; }
.mc-value { font-size: 16px; font-weight: 700; margin-top: 1px; }
.mc-sub { font-size: 9px; color: var(--muted); }

.mc-spark {
  width: 48px;
  height: 20px;
  opacity: 0.5;
}

/* ── Legend (Bottom-Right) ──────────────────────────── */
.legend {
  position: absolute;
  bottom: 16px;
  right: 16px;
  z-index: 10;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lg-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  color: var(--muted);
}

.lg-line {
  width: 28px;
  height: 0;
}

.lg-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

/* ── Tooltip ────────────────────────────────────────── */
.tooltip {
  position: absolute;
  z-index: 30;
  pointer-events: none;
  padding: 14px 16px;
  min-width: 210px;
  max-width: 260px;
  box-shadow: 0 8px 32px rgba(0,0,0,.6);
}

.tooltip.hidden { display: none; }

.tt-name {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
}

.tt-row {
  display: flex;
  justify-content: space-between;
  padding: 2px 0;
  font-size: 11px;
}

.tt-label { color: var(--muted); }
.tt-value { font-weight: 600; }

.tt-bar {
  height: 3px;
  border-radius: 2px;
  background: rgba(255,255,255,.06);
  margin-top: 6px;
  overflow: hidden;
}

.tt-bar-fill {
  height: 100%;
  border-radius: 2px;
  transition: width 0.3s ease;
}

/* ── Perf Counter ───────────────────────────────────── */
.perf-counter {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 9px;
  color: rgba(100,116,139,.5);
  z-index: 10;
  pointer-events: none;
  font-variant-numeric: tabular-nums;
  letter-spacing: .5px;
}

/* ── Color Utilities ────────────────────────────────── */
.c-green  { color: var(--green); }
.c-red    { color: var(--red); }
.c-amber  { color: var(--amber); }
.c-blue   { color: var(--blue); }
.c-purple { color: var(--accent); }
.c-cyan   { color: var(--cyan); }

.bg-green  { background: rgba(34,197,94,.12); }
.bg-red    { background: rgba(239,68,68,.12); }
.bg-amber  { background: rgba(245,158,11,.12); }
.bg-blue   { background: rgba(59,130,246,.12); }
.bg-purple { background: rgba(124,58,237,.12); }
.bg-cyan   { background: rgba(6,182,212,.12); }
