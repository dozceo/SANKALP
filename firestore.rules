rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: Check if user is a teacher
    function isTeacher() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    
    // Helper function: Check if user is teacher of specific class
    function isTeacherOfClass(classId) {
      return isTeacher() && 
             get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated();
      allow update: if isOwner(userId);
    }
    
    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId);
      allow write: if isOwner(teacherId);
    }
    
    // Classes collection
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update: if isTeacherOfClass(classId);
      allow delete: if isTeacherOfClass(classId);
    }
    
    // Students collection
    match /students/{studentId} {
      allow read: if isOwner(studentId) || 
                    (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId);
    }
    
    // Quiz Results collection
    match /quizResults/{resultId} {
      allow read: if isAuthenticated() && 
                    (resource.data.studentId == request.auth.uid ||
                     resource.data.teacherId == request.auth.uid);
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ML Predictions cache
    match /mlPredictions/{predictionId} {
      allow read: if isAuthenticated() && 
                    resource.data.studentId == request.auth.uid;
      allow write: if false;
    }
    
    // ADK Decisions audit trail
    match /adkDecisions/{decisionId} {
      allow read: if isAuthenticated() && 
                    resource.data.studentId == request.auth.uid;
      allow write: if false;
    }
    
    // Teacher Interventions
    match /teacherInterventions/{interventionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // Syllabi
    match /syllabi/{syllabusId} {
      allow read, write: if isAuthenticated() && 
                           resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
    }
    
    // Quiz Generations
    match /quizGenerations/{quizId} {
      allow read, write: if isAuthenticated() && 
                           resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
    }
    
    // SANKALP Sessions
    match /sankalpSessions/{sessionId} {
      allow read: if isAuthenticated() && 
                    (resource.data.studentId == request.auth.uid ||
                     (isTeacher() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherId == request.auth.uid));
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && 
                      resource.data.studentId == request.auth.uid;
    }
    
    // Activity Logs
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && 
                    resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
      allow write: if false; // Immutable after creation
    }
    
    // Chat History (Private by default)
    match /chatHistory/{chatId} {
      allow read: if isAuthenticated() && 
                    resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && 
                      resource.data.studentId == request.auth.uid; // For sharing toggle
      allow delete: if isAuthenticated() && 
                      resource.data.studentId == request.auth.uid; // Can delete own chats
    }
    
    // Brain Map Nodes
    match /brainMapNodes/{nodeId} {
      allow read, write: if isAuthenticated() && 
                           resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
    }
    
    // Planner Data
    match /plannerData/{itemId} {
      allow read, write: if isAuthenticated() && 
                           resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && 
                      request.resource.data.studentId == request.auth.uid;
    }
    
    // Daily Summaries (Students read own, Teachers read their students')
    match /dailySummaries/{summaryId} {
      allow read: if isAuthenticated() && 
                    (resource.data.studentId == request.auth.uid ||
                     (isTeacher() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherId == request.auth.uid));
      allow write: if false; // Only server generates summaries
    }
  }
}

